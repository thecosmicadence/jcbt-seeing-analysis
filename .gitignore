*.fits
*.spe
*.csv
*.dat
data/

# --- OS System Files ---
.DS_Store
Thumbs.db

# --- Logs & Temporary Files ---
*.log
*.tmp
temp/

# --- IDE Settings (Optional but recommended) ---
.vscode/
.idea/
